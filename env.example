# Copie para .env.local e preencha com os valores do SEU projecto Supabase
# (Project Settings -> API). Só a chave "anon"/publishable vai aqui.
# NUNCA coloque a chave "service_role" no frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional: fornecedor de tiles para o mapa (MapLibre). Vazio = mapa desactivado.
VITE_MAP_STYLE_URL=
